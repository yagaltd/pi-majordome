{
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["index.ts", "ext/**/*.ts", "tools/**/*.ts"]
}
